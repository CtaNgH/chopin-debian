# chopin Debian 13 + GNOME 版本锁（所有脚本的唯一版本来源）

DEBIAN_SUITE=trixie
DEBIAN_RELEASE=13.7
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY=https://mirrors.tuna.tsinghua.edu.cn/debian-security

ROOTFS_LABEL=chopinroot
ROOTFS_SIZE_MB=8192
ROOTFS_IMG_NAME=chopin-rootfs.img
ROOTFS_SPARSE_NAME=chopin-rootfs.sparse.img

MESA_VERSION=25.0.7-2+deb13u1
MESA_SOURCE_VERSION=25.0.7
MESA_TARBALL_URL=https://mirrors.tuna.tsinghua.edu.cn/debian/pool/main/m/mesa/mesa_25.0.7.orig.tar.xz
MESA_TARBALL_SHA256=592272df3cf01e85e7db300c449df5061092574d099da275d19e97ef0510f8a6
MESA_REPO=https://github.com/MT6891-Mainline/mesa.git
MESA_COMMIT=b52e2e3a
MESA_BUILD_JOBS=8

CHOPIN_USER=chopin
CHOPIN_PASSWORD=chopin
CHOPIN_HOSTNAME=chopin
CHOPIN_TIMEZONE=Asia/Shanghai

# 原厂镜像模板（WSL 里通过 /mnt/d 访问 Windows 工作区）
STOCK_BOOT=/mnt/d/MT6891-Mainline/chopin/images/boot_a.img
