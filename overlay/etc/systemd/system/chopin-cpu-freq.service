[Unit]
Description=chopin: pin the A78 cluster PLL
# Before the session starts, so the offline window costs nothing.
Before=gdm.service
After=local-fs.target
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/chopin-cpu-freq.sh

[Install]
WantedBy=multi-user.target
