[Unit]
Description=chopin: power button toggles the screen (backlight)
# No After=graphical.target here: combined with WantedBy=multi-user.target it
# forms an ordering cycle (graphical.target wants multi-user.target) and systemd
# drops the whole job to break it.  The daemon only needs the input node, which
# exists well before this point.
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/local/bin/chopin-powerkey
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
